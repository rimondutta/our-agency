      "html": "\n<div class=\"bg-[#030712] text-[#F8FAFC] font-['Outfit'] min-h-[1200px] p-8\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n    /* Chamfered Card Shape */\n    .chamfer-card {\n      background: #0F172A;\n      clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);\n      position: relative;\n    }\n    \n    .chamfer-card-border {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      border: 1px solid rgba(56, 189, 248, 0.15);\n      clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);\n    }\n\n    .chamfer-button {\n      clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);\n    }\n\n    /* Hex Grid Background */\n    .hex-pattern {\n      background-image: radial-gradient(rgba(56, 189, 248, 0.05) 1px, transparent 1px);\n      background-size: 32px 32px;\n    }\n\n    /* Scanning Line Animation */\n    @keyframes scan {\n      0% { transform: translateY(-100%); opacity: 0; }\n      10% { opacity: 0.5; }\n      90% { opacity: 0.5; }\n      100% { transform: translateY(200%); opacity: 0; }\n    }\n\n    .scanning-line {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 4px;\n      background: linear-gradient(90deg, transparent, var(--scan-color, #38BDF8), transparent);\n      box-shadow: 0 0 15px var(--scan-color, #38BDF8);\n      opacity: 0;\n      pointer-events: none;\n      z-index: 10;\n    }\n\n    .group:hover .scanning-line {\n      animation: scan 2s linear infinite;\n    }\n\n    /* Glows */\n    .glow-magenta { text-shadow: 0 0 8px #E879F9; }\n    .glow-blue { text-shadow: 0 0 8px #38BDF8; }\n\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar { width: 4px; height: 4px; }\n    ::-webkit-scrollbar-track { background: #030712; }\n    ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 10px; }\n  </style>\n\n  <div class=\"max-w-[1400px] mx-auto\" data-kid=\"2\">\n    \n    <header class=\"flex items-center justify-between mb-10 pb-6 border-b border-white/5\" data-kid=\"3\">\n      <div class=\"flex items-center gap-6\" data-kid=\"4\">\n        <div class=\"relative\" data-kid=\"5\">\n          <div class=\"w-14 h-14 bg-[#0F172A] flex items-center justify-center chamfer-card\" data-kid=\"6\">\n            <i class=\"ti ti-radio text-3xl text-[#E879F9] glow-magenta\" data-kid=\"7\"></i>\n            <div class=\"absolute -top-1 -right-1 w-3 h-3 bg-[#E879F9] rounded-full animate-ping\" data-kid=\"8\"></div>\n            <div class=\"absolute -top-1 -right-1 w-3 h-3 bg-[#E879F9] rounded-full\" data-kid=\"9\"></div>\n          </div>\n        </div>\n        <div data-kid=\"10\">\n          <h1 class=\"text-3xl font-bold tracking-tighter text-white uppercase\" data-kid=\"11\">Agency_Intel</h1>\n          <div class=\"flex items-center gap-3 mt-1\" data-kid=\"12\">\n            <span class=\"text-[10px] font-mono text-[#67E8F9] uppercase tracking-widest bg-[#38BDF8]/10 px-2 py-0.5 border border-[#38BDF8]/20\" data-kid=\"13\">System_Live: v4.2.0</span>\n            <span class=\"text-[10px] font-mono text-white/40 uppercase tracking-widest\" data-kid=\"14\">Core_Temp: 32°C</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-8\" data-kid=\"15\">\n        <div class=\"flex items-center gap-2 font-mono\" data-kid=\"16\">\n          <div class=\"text-right\" data-kid=\"17\">\n            <div class=\"text-[10px] text-[#67E8F9] uppercase tracking-tighter\" data-kid=\"18\">OPERATOR_ID</div>\n            <div class=\"text-xs font-bold text-white\" data-kid=\"19\">XN