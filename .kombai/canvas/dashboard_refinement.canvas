      "html": "\n<div class=\"bg-black text-white font-[Inter]\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@800&family=Inter:wght@300;400;600&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-header { font-family: 'Barlow', sans-serif; }\n        .font-body { font-family: 'Inter', sans-serif; }\n        \n        /* Custom scrollbar for clean look */\n        ::-webkit-scrollbar { width: 4px; }\n        ::-webkit-scrollbar-track { background: #000; }\n        ::-webkit-scrollbar-thumb { background: #1A1A1A; }\n        ::-webkit-scrollbar-thumb:hover { background: #C9F31D; }\n\n        /* Animation for scimitar line */\n        @keyframes drawScimitar {\n            to { stroke-dashoffset: 0; }\n        }\n        .scimitar-path {\n            stroke-dasharray: 2000;\n            stroke-dashoffset: 2000;\n            animation: drawScimitar 2s ease-out forwards;\n        }\n    </style>\n\n    \n    <header class=\"px-12 pt-20 pb-8\" data-kid=\"2\">\n        <div class=\"flex justify-between items-end border-b border-[#1A1A1A] pb-12\" data-kid=\"3\">\n            <div class=\"space-y-4\" data-kid=\"4\">\n                <h1 class=\"text-[14rem] font-header font-extrabold tracking-tighter leading-[0.75] m-0 uppercase select-none opacity-95\" data-kid=\"5\">\n                    OVERVIEW\n                </h1>\n                <p class=\"text-[#A1A1AA] text-xs font-body font-light uppercase tracking-[0.5em] ml-3\" data-kid=\"6\">STARK INTELLIGENCE MATRIX v4.0</p>\n            </div>\n            <div class=\"flex flex-col items-end space-y-8 pb-4\" data-kid=\"7\">\n                <div class=\"text-right\" data-kid=\"8\">\n                    <span class=\"block text-[#A1A1AA] text-[10px] font-body font-light uppercase tracking-[0.3em] mb-1\" data-kid=\"9\">SYSTEM TIMESTAMP</span>\n                    <span class=\"text-2xl font-header font-extrabold uppercase tracking-tight\" data-kid=\"10\">03 JUNE 2026</span>\n                </div>\n                <button class=\"bg-white text-black px-12 py-6 font-header font-extrabold uppercase tracking-[0.2em] text-sm hover:bg-[#C9F31D] transition-none active:scale-95 border border-white hover:border-[#C9F31D]\" data-kid=\"11\">\n                    + NEW POST\n                </button>\n            </div>\n        </div>\n    </header>\n\n    \n    <section class=\"border-y border-[#1A1A1A] bg-[#050505] grid grid-cols-4 w-full\" data-kid=\"12\">\n        <div class=\"p-14 border-r border-[#1A1A1A] group hover:bg-black transition-none cursor-crosshair\" data-kid=\"13\">\n            <div class=\"flex justify-between items-center mb-8\" data-kid=\"14\">\n                <span class=\"text-[#A1A1AA] text-[10px] font-body font-light uppercase tracking-[0.2em]\" data-kid=\"15\">Active Services</span>\n                <i class=\"ti ti-arrow-up-right text-[#C9F31D] text-2xl\" data-kid=\"16\"></i>\n            </div>\n            <div class=\"flex items-baseline space-x-3\" data-kid=\"17\">\n                <span class=\"text-8xl font-header font-extrabold tracking-tighter\" data-kid=\"18\">24</span>\n                <span class=\"text-[#C9F31D] text-xs font-body font-semibold tracking-widest\" data-kid=\"19\">Δ 02</span>\n            </div>\n            <div class=\"mt-10 h-[1px] w-full bg-[#1A1A1A] relative overflow-hidden\" data-kid=\"20\">\n                <div class=\"absolute top-0 left-0 h-full bg-[#C9F31D] transition-all duration-1000\" style=\"width: 65%;\" data-kid=\"21\"></div>\n            </div>\n        </div>\n        \n        <div class=\"p-14 border-r border-[#1A1A1A] group hover:bg-black transition-none cursor-crosshair\" data-kid=\"22\">\n            <div class=\"flex justify-between items-center mb-8\" data-kid=\"23\">\n                <span class=\"text-[#A1A1AA] text-[10px] font-body font-light uppercase tracking-[0.2em