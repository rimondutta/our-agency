{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react-helmet-async": [
        "./src/shims/react-helmet-async.tsx"
      ],
      "react-router-dom": [
        "./src/shims/react-router-dom.tsx"
      ],
      "/assets/*": [
        "./public/assets/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/legacy/Login/adminLogin.tsx",
    "src/legacy/Login/AdminLogin.tsx",
    "src/Routers.tsx",
    "src/PagesRouters.tsx"
  ]
}
